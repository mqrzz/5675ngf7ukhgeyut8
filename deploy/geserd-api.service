[Unit]
Description=geserd API
After=network.target postgresql.service

[Service]
User=geserd
WorkingDirectory=/var/www/geserd-backend
EnvironmentFile=/var/www/geserd-backend/.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3
MemoryMax=200M
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
